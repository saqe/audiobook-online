# Example environment for this repo. Copy to .env and fill in real values.
#
# Nothing loads .env automatically. Use it as a reference, or pass values to:
#   - Fly:            fly secrets set KEY=value (credentials)
#                     and [env] in fly.toml (everything else)
#   - Local testing:  docker compose already sets these in docker-compose.yml
#
# Never commit real credentials. Keep .env out of git and out of the image.

# --- Required: S3-compatible bucket (secrets on Fly) ---
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=audiobooks
S3_ACCESS_KEY_ID=your-read-only-access-key-id
S3_SECRET_ACCESS_KEY=your-read-only-secret-access-key

# --- Optional: provider settings (defaults shown) ---
# rclone provider name: Cloudflare, Other, AWS, Minio, ...
S3_PROVIDER=Other
S3_REGION=auto
# Mount only this folder of the bucket (empty = whole bucket)
S3_PREFIX=

# --- Optional: mount and cache (defaults shown) ---
MOUNT_POINT=/audiobooks
# off = stream from S3, nothing stored on the volume (recommended). full = cache files on the volume
VFS_CACHE_MODE=off
# Keep well below the volume size
VFS_CACHE_MAX_SIZE=5G
# How long directory listings are cached before re-reading the bucket
DIR_CACHE_TIME=5m
CACHE_DIR=/data/rclone-cache

# --- Cloudflare Tunnel: private access (secret, use `fly secrets set TUNNEL_TOKEN=...`) ---
# Token of a remotely-managed tunnel from Cloudflare Zero Trust > Networks > Tunnels
TUNNEL_TOKEN=REPLACE-ME
